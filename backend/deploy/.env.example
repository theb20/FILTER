# Copier en deploy/.env (ignoré par git). Ne jamais committer de secret.
ALLOWED_ORIGINS=http://localhost:5173
POSTGRES_PASSWORD=

# ── E-mails transactionnels (Resend) ─────────────────────────────────────────
# Sans RESEND_API_KEY, AUCUN e-mail ne part : ni vérification d'adresse, ni
# réinitialisation de mot de passe, ni invitation au backoffice.
# La clé commence par « re_ ». Elle se crée sur https://resend.com/api-keys
# avec la permission « Sending access » seulement.
RESEND_API_KEY=
# Expéditeur : le DOMAINE doit être vérifié chez Resend (DNS : SPF + DKIM),
# sinon l'envoi est refusé en 4xx. Pour un premier essai sans domaine vérifié,
# Resend accepte « onboarding@resend.dev » — mais uniquement vers l'adresse du
# compte Resend lui-même.
MAIL_FROM=FilterFinder <bonjour@votre-domaine.be>
# Adresse de réponse réelle (facultatif) : les clients répondent ici.
MAIL_REPLY_TO=
# Nom affiché dans le bandeau et le pied des e-mails (défaut : FilterFinder).
BRAND_NAME=FilterFinder
# Servent à construire les liens contenus dans les e-mails. SANS barre finale.
SITE_URL=https://votre-domaine.be
BACKOFFICE_URL=https://admin.votre-domaine.be
